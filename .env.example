# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nghenhac
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Cloudflare R2 / S3 Configuration
R2_ENDPOINT=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET_SONGS=songs
R2_BUCKET_COVERS=covers

# JWT Configuration (Must be at least 256-bit strong base64 or plaintext key)
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough_to_be_secure_123456789
